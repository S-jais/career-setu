# ============================================================
# CareerSetu — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/careersetu
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=careersetu
DATABASE_USER=careersetu_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_512_BIT_SECRET_KEY_FOR_PRODUCTION
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Keycloak / OIDC ──────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=careersetu
KEYCLOAK_CLIENT_ID=careersetu-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
OIDC_ISSUER_URI=http://localhost:8080/realms/careersetu

# ── Object Storage (MinIO / S3-compatible) ───────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET_DOCUMENTS=careersetu-documents
S3_BUCKET_AVATARS=careersetu-avatars
S3_REGION=ap-south-1

# ── OpenSearch ───────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH_PASSWORD

# ── AI Provider ──────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
AI_API_KEY=CHANGE_ME_GEMINI_API_KEY
AI_FALLBACK_PROVIDER=none
AI_EMBEDDING_MODEL=models/text-embedding-004
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# ── OpenAI (optional fallback) ───────────────────────────────
OPENAI_API_KEY=CHANGE_ME_OPENAI_KEY
OPENAI_MODEL=gpt-4o

# ── AI Service ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_SECRET=CHANGE_ME_INTERNAL_SECRET_256BIT

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@careersetu.in
SMTP_FROM_NAME=CareerSetu

# ── SMS (Abstraction) ────────────────────────────────────────
SMS_PROVIDER=disabled
SMS_API_KEY=CHANGE_ME_SMS_KEY

# ── Kafka / RabbitMQ ─────────────────────────────────────────
MESSAGE_BROKER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Spring Boot ──────────────────────────────────────────────
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=development

# ── FastAPI AI Service ───────────────────────────────────────
FASTAPI_PORT=8001
FASTAPI_WORKERS=4
FASTAPI_LOG_LEVEL=info

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001
VITE_APP_NAME=CareerSetu
VITE_APP_ENV=development
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID

# ── Observability ────────────────────────────────────────────
OTEL_SERVICE_NAME=careersetu-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Security ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_FILE_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png

# ── Feature Flags ────────────────────────────────────────────
FEATURE_AI_ENABLED=true
FEATURE_KEYCLOAK_ENABLED=false
FEATURE_MFA_ENABLED=true
FEATURE_ANTISCAM_ENABLED=true
FEATURE_RAG_ENABLED=false
